# Test stack template - copy to `.env` next to docker-compose.yml, fill in, `chmod 600 .env`.
# Never commit the filled-in file. Production uses ../production.env.example instead.

NODE_ENV=production
APP_URL=http://localhost:3000

# openssl rand -base64 32     (>= 32 chars; signs sessions and CSRF tokens)
APP_SECRET_KEY=
# openssl rand -base64 32     (back this up: without it every stored secret is unreadable)
APP_ENCRYPTION_KEY=

# SQLite inside the app-data volume.
DATABASE_URL=file:/data/powerdns_authadmin.db

# First admin account; the panel asks for a new password on first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
# openssl rand -base64 18     (>= 12 chars)
BOOTSTRAP_ADMIN_PASSWORD=

# PowerDNS API key - the panel's PowerDNS server entry uses the same value.
# openssl rand -hex 24
PDNS_API_KEY=

# openssl rand -base64 18
KEYCLOAK_ADMIN_PASSWORD=

# The test stack reaches PowerDNS, Keycloak and PowerGSLB on the private Docker
# network, and PowerDNS over plain http. Leave these unset in production.
APP_PDNS_ALLOW_PRIVATE_NETWORKS=true
APP_PDNS_ALLOW_INSECURE_HTTP=true
APP_OIDC_ALLOW_PRIVATE_NETWORKS=true
APP_OIDC_ALLOW_INSECURE_HTTP=true
APP_GSLB_ALLOW_PRIVATE_NETWORKS=true

METRICS_ENABLED=false
