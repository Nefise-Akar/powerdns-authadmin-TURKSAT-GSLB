# Production template - copy to `.env` (cp production.env.example .env), fill in, then `chmod 600 .env`.
# Never commit the filled-in file. Generate secrets once and never rotate them.

# Public https URL exactly as the browser sees it (no trailing slash).
APP_URL=https://dns.example.org

# openssl rand -base64 32     (>= 32 chars; signs sessions and CSRF tokens)
APP_SECRET_KEY=
# openssl rand -base64 32     (back this up: without it every stored secret is unreadable)
APP_ENCRYPTION_KEY=

# openssl rand -base64 18
POSTGRES_PASSWORD=

# First admin account; change the password on first sign-in and enable MFA.
BOOTSTRAP_ADMIN_EMAIL=
# openssl rand -base64 18     (>= 12 chars)
BOOTSTRAP_ADMIN_PASSWORD=

# Optional
# LOCAL_AUTH_ENABLED=true      # false = SSO-only (verify a Keycloak admin can sign in first)
# SESSION_TTL_SECONDS=43200
# LOG_LEVEL=info
# METRICS_ENABLED=false        # true needs METRICS_TOKEN (>= 16 chars)
# REDIS_URL=                   # required only when running more than one panel replica
